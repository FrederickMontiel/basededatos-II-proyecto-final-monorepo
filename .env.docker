# Development Environment Variables - Docker + Mirroring

# Database (interno 1433, expuesto 5001)
# Con mirroring: principal,mirror para failover automático
# Sin mirroring: solo mssql
DATABASE_HOST=mssql,mssql-mirror
DATABASE_PORT=1433
DATABASE_USER=sa
DATABASE_PASSWORD=Pass1234
DATABASE_NAME=InnovacionCRM

# Backend (interno 3000, expuesto 5002)
NODE_ENV=development
PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend (interno 4200, expuesto 5003)
# En Docker: usa hostname servicio backend
API_URL=http://backend:3000/api

# Docker
COMPOSE_PROJECT_NAME=innovacion-crm
